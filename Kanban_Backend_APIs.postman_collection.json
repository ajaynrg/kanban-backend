	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default values if variables are not defined",
					"if (!pm.environment.get('baseUrl')) {",
					"    pm.environment.set('baseUrl', 'http://localhost:5000');",
					"}",
					"",
					"// Log the request for debugging",
					"console.log('Making request to:', pm.request.url.toString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Common test scripts for all requests",
					"pm.test('Response time is less than 2000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(2000);",
					"});",
					"",
					"pm.test('Response should be JSON', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"});",
					"",
					"// Store IDs from successful POST requests for use in other requests",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    const responseJson = pm.response.json();",
					"    ",
					"    // Store board ID if this is a board creation",
					"    if (pm.request.url.toString().includes('/api/boards') && pm.request.method === 'POST') {",
					"        if (responseJson._id || responseJson.id) {",
					"            pm.environment.set('boardId', responseJson._id || responseJson.id);",
					"            console.log('Stored boardId:', responseJson._id || responseJson.id);",
					"        }",
					"    }",
					"    ",
					"    // Store list ID if this is a list creation",
					"    if (pm.request.url.toString().includes('/api/lists') && pm.request.method === 'POST') {",
					"        if (responseJson._id || responseJson.id) {",
					"            pm.environment.set('listId', responseJson._id || responseJson.id);",
					"            console.log('Stored listId:', responseJson._id || responseJson.id);",
					"        }",
					"    }",
					"    ",
					"    // Store card ID if this is a card creation",
					"    if (pm.request.url.toString().includes('/api/cards') && pm.request.method === 'POST') {",
					"        if (responseJson._id || responseJson.id) {",
					"            pm.environment.set('cardId', responseJson._id || responseJson.id);",
					"            console.log('Stored cardId:', responseJson._id || responseJson.id);",
					"        }",
					"    }",
					"}"
				]
			}
		}
	],
